# =====================================================
# 1. الإعدادات الأساسية
# =====================================================
TELEGRAM_BOT_TOKEN = "8850057335:AAHm7mda1hRWMz5IOAsAoG4PUeYxdFeFm48"
TELEGRAM_CHAT_ID = "587293170"

FF_CALENDAR_URL = "https://nfs.faireconomy.media/ff_calendar_thisweek.json"
LOCAL_TIMEZONE = pytz.timezone("Asia/Baghdad")

ALLOWED_IMPACTS = ["High", "Medium", "Low"]

